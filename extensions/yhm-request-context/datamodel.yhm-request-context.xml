        <method id="FillYourHealthMatchContext" _delta="define">
          <static>false</static>
          <access>protected</access>
          <type>Custom</type>
          <code><![CDATA[protected function FillYourHealthMatchContext()
{
    if (((int) $this->Get('org_id')) === 0) {
        $org = MetaModel::GetObjectByName('Organization', 'YourHealthMatch', false);
        if ($org !== null) {
            $this->Set('org_id', $org->GetKey());
        }
    }
    if (((int) $this->Get('caller_id')) === 0) {
        $search = new DBObjectSearch('Person');
        $search->AddCondition('first_name', 'Business');
        $caller = (new DBObjectSet($search))->Fetch();
        if ($caller !== null) {
            $this->Set('caller_id', $caller->GetKey());
        }
    }
}]]></code>
        </method>
